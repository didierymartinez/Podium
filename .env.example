# --- Base de datos ---------------------------------------------------------
# Rol de la aplicación (sin BYPASSRLS). En Neon: usar la cadena "pooled".
DATABASE_URL=postgres://podium_app:podium_app_dev@localhost:5432/podium
# Rol dueño del esquema, solo para migraciones. En Neon: cadena directa (no pooled).
MIGRATIONS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/podium

# --- Sesión -----------------------------------------------------------------
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
SESSION_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres

# Cifrado de datos de salud (32 bytes en base64). Generar con: openssl rand -base64 32
DATA_ENCRYPTION_KEY=ZGV2LWtleS1kZXYta2V5LWRldi1rZXktZGV2LWtleTE=

# --- Autenticación ------------------------------------------------------------
# "firebase" (producción) o "dev" (solo local: ingreso con email, sin contraseña)
NEXT_PUBLIC_AUTH_PROVIDER=dev
# ALLOW_DEV_AUTH=true   # permite "dev" con NODE_ENV=production (solo pruebas E2E locales)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- App ------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
