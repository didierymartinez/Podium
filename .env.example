# --- Base de datos ---------------------------------------------------------
# Rol de la aplicación (sin BYPASSRLS). En Neon: usar la cadena "pooled".
DATABASE_URL=postgres://podium_app:podium_app_dev@localhost:5432/podium
# Rol dueño del esquema, solo para migraciones. En Neon: cadena directa (no pooled).
MIGRATIONS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/podium

# --- Sesión -----------------------------------------------------------------
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
SESSION_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres

# Cifrado de datos de salud (32 bytes en base64). Generar con: openssl rand -base64 32
DATA_ENCRYPTION_KEY=ZGV2LWtleS1kZXYta2V5LWRldi1rZXktZGV2LWtleTE=

# --- Autenticación ------------------------------------------------------------
# "firebase" (producción) o "dev" (solo local: ingreso con email, sin contraseña)
NEXT_PUBLIC_AUTH_PROVIDER=dev
# ALLOW_DEV_AUTH=true   # permite "dev" con NODE_ENV=production (solo pruebas E2E locales)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- App ------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Archivos ---------------------------------------------------------------------
# "local" (disco; desarrollo, E2E o VPS de un servidor) o "s3" (Cloudflare R2, AWS S3, MinIO)
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=/var/lib/podium/storage
# R2: https://<cuenta>.r2.cloudflarestorage.com · MinIO local: http://localhost:9000
# S3_ENDPOINT=
# S3_BUCKET=podium
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# --- Tareas programadas ---------------------------------------------------------
# Secreto para /api/cron/* (Authorization: Bearer <CRON_SECRET>). Generar con: openssl rand -hex 24
# CRON_SECRET=

# --- Correo (Resend) ---------------------------------------------------------------
# Sin RESEND_API_KEY los correos se imprimen en la consola.
# RESEND_API_KEY=
# EMAIL_FROM="Podium <hola@tu-dominio.co>"

# --- Notificaciones push (Firebase Cloud Messaging) ---------------------------------
# Clave VAPID pública (Firebase → Configuración del proyecto → Cloud Messaging → Certificados push web)
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Cuenta de servicio (JSON en una sola línea) para enviar con la API HTTP v1
# FIREBASE_SERVICE_ACCOUNT=

# Captcha Cloudflare Turnstile (#20). Sin estas llaves no se pide captcha (desarrollo y pruebas).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Intentos de ingreso/registro por IP: "máximo/segundos" (por defecto 20 cada 10 minutos).
AUTH_RATE_LIMIT=
# Envíos de la pre-inscripción pública por IP (#65): "máximo/segundos" (por defecto 10/3600).
SIGNUP_RATE_LIMIT=

# Cuenta Wompi DE PODIUM para cobrar la suscripción de las escuelas (#21). No es la de cada escuela.
PODIUM_WOMPI_PUBLIC_KEY=
PODIUM_WOMPI_PRIVATE_KEY=
PODIUM_WOMPI_EVENTS_SECRET=
PODIUM_WOMPI_INTEGRITY_SECRET=

# Super admins de Podium (consola /admin, #17): emails separados por coma. Con Firebase exigen 2FA (TOTP).
PLATFORM_ADMIN_EMAILS=

# WhatsApp Cloud API con el número de Podium (#64). Sin estas llaves los avisos van por push y correo.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Plantilla de utilidad aprobada en Meta ({{1}} escuela, {{2}} resumen, {{3}} enlace) e idioma.
WHATSAPP_TEMPLATE=aviso_podium
WHATSAPP_TEMPLATE_LANG=es
